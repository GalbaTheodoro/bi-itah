# ===== Banco (o mesmo do Power BI) =====
DB_SERVER=dbfeeditah.database.windows.net
DB_DATABASE=dbfeeditah
DB_USER=adm
DB_PASSWORD=DIGITE_A_SENHA_AQUI

# ===== Servidor web =====
PORT=3000
# Troque por um texto longo e aleatório
SESSION_SECRET=59428ce59e4c2a590edc75b56df5574b5b0df660ea7399d41ab49124b6b5ad32
# Tempo de sessão em horas
SESSION_HORAS=10

# ===== Tabela de usuários =====
# Rode "npm run descobrir-usuario" para descobrir os nomes certos
USER_TABLE=TB_USUARIO
USER_COL_LOGIN=Usuario
USER_COL_SENHA=Senha
USER_COL_NOME=Usuario
# Opcional: coluna que indica usuário ativo e o valor que significa "ativo"
USER_COL_ATIVO=ativo
USER_ATIVO_VALOR=1
# auto | plain | md5 | sha1 | sha256 | sha512 | bcrypt
PASSWORD_MODE=plain

# Cotação do dólar padrão para contratos de exportação (IT) no relatório de lucro
DOLAR=

# Tempo (minutos) que os dados ficam em cache antes de reconsultar o banco
CACHE_MINUTOS=5

# Usuários administradores do BI (separados por vírgula): veem tudo e liberam acessos
ADMIN_USUARIOS=ADM
